{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Versioned historical source evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "policy_id",
    "title",
    "source_url",
    "evidence_level",
    "source_language",
    "edition",
    "fetched_at",
    "published_at",
    "source_current_through",
    "coverage",
    "source_currentness_verified",
    "review",
    "extractor_version",
    "raw_sha256",
    "normalized_sha256",
    "raw_file",
    "normalized_file",
    "anchors",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": {
          "type": "string"
        },
        "zh": {
          "type": "string"
        }
      }
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "evidence_level": {
      "const": "source_document"
    },
    "source_language": {
      "const": "en"
    },
    "edition": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": ["string", "null"],
      "format": "date"
    },
    "source_current_through": {
      "type": "string",
      "format": "date"
    },
    "coverage": {
      "const": "historical_snapshot"
    },
    "source_currentness_verified": {
      "const": false
    },
    "review": {
      "$ref": "#/definitions/review"
    },
    "extractor_version": {
      "type": "string",
      "minLength": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normalized_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_file": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-f0-9]{64}\\.html\\.txt$"
    },
    "normalized_file": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-f0-9]{64}\\.normalized\\.txt$"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/anchor"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "definitions": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "method"],
      "properties": {
        "status": {
          "enum": ["draft", "verified"]
        },
        "reviewer": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "method": {
          "enum": ["not_reviewed", "human"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date"
              },
              "method": {
                "const": "human"
              }
            }
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "locator",
        "exact_quote",
        "version_sha256",
        "review",
        "start_offset",
        "end_offset",
        "offset_unit",
        "state",
        "usable_as_reviewed_reference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "exact_quote": {
          "type": "string",
          "minLength": 1
        },
        "version_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review": {
          "$ref": "#/definitions/review"
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1
        },
        "offset_unit": {
          "const": "utf16_code_units"
        },
        "state": {
          "enum": [
            "needs_review",
            "verified",
            "source_changed",
            "extractor_changed"
          ]
        },
        "usable_as_reviewed_reference": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "usable_as_reviewed_reference": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "verified"
              },
              "review": {
                "properties": {
                  "status": {
                    "const": "verified"
                  },
                  "method": {
                    "const": "human"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "state": {
                "enum": ["needs_review", "source_changed", "extractor_changed"]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "draft"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "anchors": {
            "items": {
              "properties": {
                "usable_as_reviewed_reference": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  ]
}
