---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  keywords?: string;
}

const {
  title,
  description = 'CCUS Policy Hub - 全球 CCUS 政策数据库与分析平台',
  image = '/social-preview.png',
  canonicalURL = Astro.url.href,
  keywords,
} = Astro.props;

const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = /^https?:\/\//.test(image)
  ? image
  : new URL(`${siteBase}${image}`, Astro.site ?? Astro.url).href;

// Mirror of LanguagePicker's route allowlist: emit hreflang alternates only
// when the other locale actually has a route.
const EN_ROUTE_SEGMENTS = new Set([
  'about',
  'compare',
  'docs',
  'facilities',
  'policy',
  'quality',
  'search',
]);

const pathWithoutBase =
  (Astro.url.pathname.startsWith(siteBase)
    ? Astro.url.pathname.slice(siteBase.length)
    : Astro.url.pathname) || '/';
const segments = pathWithoutBase.replace(/^\/+/, '').split('/');
const hasEnCounterpart =
  pathWithoutBase === '/' ||
  (segments.length > 0 &&
    EN_ROUTE_SEGMENTS.has(segments[0]) &&
    !(segments[0] === 'policy' && segments[1] === 'country'));

const zhURL = new URL(
  `${siteBase}${pathWithoutBase.startsWith('/en') ? pathWithoutBase.replace('/en', '') || '/' : pathWithoutBase}`.replace(
    /\/?$/,
    '/'
  ),
  Astro.site
);
const enURL = new URL(
  pathWithoutBase.startsWith('/en')
    ? Astro.url.pathname
    : hasEnCounterpart
      ? `${siteBase}/en${pathWithoutBase === '/' ? '/' : pathWithoutBase}`.replace(
          /\/?$/,
          '/'
        )
      : `${siteBase}/en/`,
  Astro.site
);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/ccus-policy-hub/favicon.svg" />
<meta name="generator" content={Astro.generator} />
{keywords && <meta name="keywords" content={keywords} />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternates -->
<link rel="alternate" hreflang="zh-CN" href={zhURL.href} />
<link rel="alternate" hreflang="en" href={enURL.href} />
<link rel="alternate" hreflang="x-default" href={zhURL.href} />

<!-- Primary Meta Tags -->
<title>{title} | CCUS Policy Hub</title>
<meta name="title" content={`${title} | CCUS Policy Hub`} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
