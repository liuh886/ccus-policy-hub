---
import FacilitiesIndex from '../../../components/FacilitiesIndex.astro';
import { getLocaleDataIndex } from '../../../lib/dataIndex';
import { SITE_BASE } from '../../../lib/siteBase';
import {
  facilitiesPageCount,
  facilitiesPageSlice,
} from '../../../lib/facilityPagination.mjs';

const { sortedFacilities: sorted } = await getLocaleDataIndex('en');
const total = facilitiesPageCount(sorted.length);
---

<FacilitiesIndex
  lang="en"
  items={facilitiesPageSlice(sorted, 1)}
  pagination={total > 1
    ? {
        current: 1,
        total,
        prevUrl: undefined,
        nextUrl: total >= 2 ? `${SITE_BASE}/en/facilities/page/2/` : undefined,
      }
    : undefined}
/>
