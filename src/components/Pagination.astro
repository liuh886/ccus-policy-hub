---
import { t as translateUi, defaultLang, type UiKey } from '../i18n/ui';

interface Props {
  prevUrl?: string;
  nextUrl?: string;
  current: number;
  total: number;
  lang?: 'zh' | 'en';
}

const { prevUrl, nextUrl, current, total, lang = defaultLang } = Astro.props;
const t = (key: UiKey) => translateUi(lang, key);
---

<nav class="flex justify-center items-center gap-4 mt-12">
  {
    prevUrl ? (
      <a
        href={prevUrl}
        class="px-4 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg hover:border-blue-500 transition-colors text-sm font-medium"
      >
        &larr; {t('pagination.prev')}
      </a>
    ) : (
      <span class="px-4 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-900 rounded-lg text-slate-300 text-sm cursor-not-allowed">
        &larr; {t('pagination.prev')}
      </span>
    )
  }

  <span class="text-sm font-bold text-slate-500">
    {t('stats.page')}
    {current}
    {t('stats.of')}
    {total}
  </span>

  {
    nextUrl ? (
      <a
        href={nextUrl}
        class="px-4 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg hover:border-blue-500 transition-colors text-sm font-medium"
      >
        {t('pagination.next')} &rarr;
      </a>
    ) : (
      <span class="px-4 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-900 rounded-lg text-slate-300 text-sm cursor-not-allowed">
        {t('pagination.next')} &rarr;
      </span>
    )
  }
</nav>
