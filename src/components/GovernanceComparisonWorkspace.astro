---
import { getCollection } from 'astro:content';
import GovernanceAnalyticsPanels from './GovernanceAnalyticsPanels.astro';
import countryData from '../data/countries.json';
import { governanceComparisonCopy } from '../lib/governanceCopy.mjs';
import { governanceClientCopy } from '../lib/governanceCopy.mjs';
import {
  toCompareFacility,
  toComparePolicy,
  toCompareProfile,
} from '../lib/comparePayload.mjs';

const lang = Astro.props.lang === 'en' ? 'en' : 'zh';
const policies = await getCollection(
  lang === 'en' ? 'policies_en' : 'policies_zh'
);
const facilities = await getCollection(
  lang === 'en' ? 'facilities_en' : 'facilities_zh'
);
const profiles = await getCollection(
  lang === 'en' ? 'countries_en' : 'countries_zh'
);
const text = governanceComparisonCopy[lang];
const clientText = governanceClientCopy[lang];
const safeJson = (data: unknown) =>
  JSON.stringify(data).replace(/</g, '\\u003c');

const presetLinks = [
  {
    id: 'big3',
    label: text.presetBig3,
    query: 'united-states,china,germany',
  },
  {
    id: 'anglosphere',
    label: text.presetAnglo,
    query: 'united-states,united-kingdom,australia',
  },
  {
    id: 'gulf',
    label: text.presetGulf,
    query: 'united-arab-emirates,saudi-arabia',
  },
  {
    id: 'nordic',
    label: text.presetNordic,
    query: 'norway,denmark,iceland',
  },
];
---

<div class="mx-auto max-w-7xl px-4 py-8">
  <header
    class="print:hidden mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
  >
    <div>
      <h1 class="mb-4 text-4xl font-black text-slate-900 dark:text-white">
        {text.pageTitle}
      </h1>
      <p class="max-w-3xl text-slate-500 dark:text-slate-400">
        {text.pageDescription}
      </p>
      <nav
        class="mt-6 flex flex-wrap items-center gap-2"
        aria-label={text.presetTitle}
      >
        <span
          class="mr-1 text-[10px] font-black uppercase tracking-widest text-slate-400"
        >
          {text.presetTitle}
        </span>
        {
          presetLinks.map((preset) => (
            <a
              href={`?countries=${preset.query}`}
              data-preset={preset.id}
              class="rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold text-slate-600 transition-colors hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-blue-400 dark:hover:text-blue-400"
            >
              {preset.label}
            </a>
          ))
        }
      </nav>
      <details class="country-selector-details mt-4 max-w-3xl">
        <summary
          class="cursor-pointer text-xs font-bold text-blue-600 hover:text-blue-700 dark:text-blue-400"
        >
          {text.selectorLabel}
        </summary>
        <div id="country-selector" class="country-selector-grid"></div>
        <p id="selector-limit" class="country-selector-hint" aria-live="polite">
        </p>
      </details>
      <div id="selected-tags" class="selected-tags" aria-live="polite"></div>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <button
        id="clear-all"
        class="px-4 py-2 text-sm font-bold text-slate-500 transition-colors hover:text-red-500"
      >
        {text.clear}
      </button>
      <button
        id="print-report"
        class="rounded-xl bg-blue-600 px-6 py-2.5 font-bold text-white shadow-lg shadow-blue-500/20 transition-colors hover:bg-blue-700"
      >
        {text.export}
      </button>
      <details class="compare-export-menu">
        <summary
          class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition-colors hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
        >
          {text.exportMenu}
        </summary>
        <div class="compare-export-menu-list">
          <button id="export-csv" type="button">{text.exportCsv}</button>
          <button id="export-json" type="button">{text.exportJson}</button>
          <button id="copy-citation" type="button">{text.copyCite}</button>
        </div>
      </details>
    </div>
  </header>

  <div class="hidden print:block mb-12 border-b-4 border-slate-900 pb-8">
    <h1 class="mb-2 text-4xl font-black text-slate-900">{text.reportTitle}</h1>
    <p class="text-slate-500">
      {text.generated}: {
        new Date().toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-GB')
      } | CCUS Policy Hub
    </p>
  </div>

  <div id="compare-container">
    <GovernanceAnalyticsPanels lang={lang} />

    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12">
      <aside class="space-y-8 lg:col-span-5">
        <section
          id="facility-stats-compare"
          class="rounded-[2rem] border border-slate-200 bg-slate-50 p-7 shadow-sm dark:border-slate-800 dark:bg-slate-900/50"
        >
          <div class="mb-6">
            <div class="flex items-center gap-3">
              <h2
                class="text-xs font-black uppercase tracking-widest text-slate-500"
              >
                {text.facilityTitle}
              </h2>
              <div class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></div>
            </div>
            <p
              class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400"
            >
              {text.facilityNote}
            </p>
          </div>
          <div id="stats-grid" class="space-y-4"></div>
        </section>
      </aside>

      <div class="space-y-12 lg:col-span-7">
        <section>
          <div class="mb-8 flex items-center gap-3">
            <h2
              class="text-sm font-bold uppercase tracking-widest text-slate-400"
            >
              {text.contributors}
            </h2>
            <div class="h-px flex-1 bg-slate-100 dark:bg-slate-800"></div>
          </div>
          <div id="policy-bundles-container" class="space-y-10"></div>
        </section>

        <details
          class="reg-details overflow-hidden rounded-[2rem] border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950"
        >
          <summary class="reg-details-summary">
            <span class="reg-details-title">{text.regulatory}</span>
            <span class="reg-details-hint">{text.regulatoryHint}</span>
            <span class="reg-details-chevron" aria-hidden="true">▾</span>
          </summary>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left">
              <thead id="reg-matrix-header"></thead>
              <tbody
                id="reg-matrix-body"
                class="divide-y divide-slate-50 dark:divide-slate-900"></tbody>
            </table>
          </div>
        </details>

        <section
          id="timeline-section"
          class="hidden overflow-hidden rounded-[2rem] border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950"
        >
          <div
            class="border-b border-slate-100 bg-slate-50 px-6 py-4 dark:border-slate-800 dark:bg-slate-900/50"
          >
            <h2
              class="text-xs font-black uppercase tracking-widest text-slate-500"
            >
              {clientText.timelineTitle}
            </h2>
          </div>
          <div id="timeline-list" class="timeline-groups"></div>
        </section>
      </div>
    </div>
  </div>

  <div
    id="empty-state"
    class="hidden rounded-[2rem] border-2 border-dashed border-slate-200 bg-slate-50 py-28 text-center dark:border-slate-800 dark:bg-slate-900/50"
  >
    <h2 class="mb-2 text-xl font-bold text-slate-900 dark:text-white">
      {text.emptyTitle}
    </h2>
    <p class="mx-auto mb-4 max-w-lg text-slate-500 dark:text-slate-400">
      {text.emptyDescription}
    </p>
    <p class="mb-6 text-sm font-bold text-slate-500 dark:text-slate-400">
      {text.emptyHint}
    </p>
    <div class="mb-10 flex flex-wrap justify-center gap-3">
      {
        presetLinks.map((preset) => (
          <a
            href={`?countries=${preset.query}`}
            data-preset={preset.id}
            class="rounded-2xl border border-slate-200 bg-white px-6 py-3 text-sm font-bold text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
          >
            {preset.label}
          </a>
        ))
      }
    </div>
    <a
      href={text.emptyHref}
      class="inline-flex rounded-xl bg-blue-600 px-8 py-3 font-bold text-white hover:bg-blue-700"
    >
      {text.emptyAction}
    </a>
  </div>
</div>

<script
  id="all-facilities-data"
  type="application/json"
  is:inline
  set:html={safeJson(facilities.map(toCompareFacility))}
/>
<script
  id="all-policies-data"
  type="application/json"
  is:inline
  set:html={safeJson(policies.map(toComparePolicy))}
/>
<script
  id="country-data"
  type="application/json"
  is:inline
  set:html={safeJson(countryData)}
/>
<script
  id="countries-profiles-data"
  type="application/json"
  is:inline
  set:html={safeJson(profiles.map(toCompareProfile))}
/>

<script>
  import { initGovernanceComparison } from '../lib/governanceComparisonClient.mjs';

  const lang = document.documentElement.lang === 'en' ? 'en' : 'zh';
  const init = () => initGovernanceComparison(lang);

  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init, { once: true });
</script>
