---
import { getCollection } from 'astro:content';
import FacilityDetail from '../../components/FacilityDetail.astro';

export async function getStaticPaths() {
  const facilities = await getCollection('facilities_zh');
  return facilities.map((entry) => {
    return { params: { slug: entry.id }, props: { entry } };
  });
}

const { entry } = Astro.props;
---

<FacilityDetail lang="zh" entry={entry} />
