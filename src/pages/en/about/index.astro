---
import Layout from '../../../layouts/Layout.astro';
import { SITE_BASE } from '../../../lib/siteBase';

const issueUrl =
  'https://github.com/liuh886/ccus-policy-hub/issues/new?labels=feedback';
const mailtoUrl = 'mailto:liuh886@users.noreply.github.com';
---

<Layout title="About Us">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-extrabold mb-6">About CCUS Policy Hub</h1>

    <div class="prose prose-slate dark:prose-invert max-w-none mb-16">
      <p class="text-lg">
        CCUS Policy Hub is an open knowledge infrastructure dedicated to
        advancing the development of carbon capture, utilization, and storage
        (CCUS) technologies worldwide.
      </p>
      <p>
        Our core mission is to eliminate information barriers in cross-border
        collaboration through structured policy data, providing a solid policy
        reference for the global energy transition.
      </p>
      <h3>Contact Us</h3>
      <p>
        Found a data error, want to contribute policy or facility records, or
        have a collaboration inquiry? Please reach out through one of the
        channels below — all feedback is tracked publicly.
      </p>
    </div>

    <div
      class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm"
    >
      <h2 class="text-2xl font-bold mb-6">Feedback &amp; Suggestions</h2>
      <div class="space-y-4">
        <a
          href={issueUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl hover:border-blue-400 transition-colors group"
        >
          <div>
            <div class="font-bold text-slate-900 dark:text-white">
              Open a GitHub issue
            </div>
            <div class="text-sm text-slate-500 dark:text-slate-400">
              Corrections, data additions, feature suggestions (public and
              trackable)
            </div>
          </div>
          <span
            class="text-blue-600 group-hover:translate-x-1 transition-transform"
            aria-hidden="true">&rarr;</span
          >
        </a>
        <a
          href={mailtoUrl}
          class="flex items-center justify-between w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl hover:border-blue-400 transition-colors group"
        >
          <div>
            <div class="font-bold text-slate-900 dark:text-white">
              Contact by email
            </div>
            <div class="text-sm text-slate-500 dark:text-slate-400">
              Collaboration inquiries and everything else
            </div>
          </div>
          <span
            class="text-blue-600 group-hover:translate-x-1 transition-transform"
            aria-hidden="true">&rarr;</span
          >
        </a>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-4">
          This is an open-source project. Audit status is published on the
          <a
            href={`${SITE_BASE}/en/quality/`}
            class="text-blue-600 hover:underline">quality dashboard</a
          >; verified corrections ship with dataset updates.
        </p>
      </div>
    </div>
  </div>
</Layout>
