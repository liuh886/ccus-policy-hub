---
import { t as translateUi, defaultLang, type UiKey } from '../i18n/ui';

interface Props {
  lang?: string;
}

const { lang = defaultLang } = Astro.props;
const t = (key: UiKey) => translateUi(lang, key);

import { SITE_BASE } from '../lib/siteBase';
const BASE = SITE_BASE;
const prefix = lang === 'zh' ? BASE : `${BASE}/${lang}`;
const currentYear = new Date().getFullYear();
const isEn = lang === 'en';
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-footer-shell">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div class="max-w-md">
        <img
          src={`${BASE}/logo_optimized.svg`}
          alt="CCUS Policy Hub"
          width="220"
          height="48"
          class="mb-5 h-12 w-auto dark:hidden"
          loading="lazy"
        />
        <img
          src={`${BASE}/logo_dark.svg`}
          alt="CCUS Policy Hub"
          width="220"
          height="48"
          class="mb-5 h-12 w-auto hidden dark:block"
          loading="lazy"
        />
        <p class="text-sm leading-6 text-slate-500 dark:text-slate-400">
          {t('footer.description')}
        </p>
        <div
          class="mt-5 flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400"
        >
          <span
            class="rounded-md border border-slate-200 px-2.5 py-1 dark:border-slate-700"
            >{isEn ? 'Open data' : '开放数据'}</span
          >
          <span
            class="rounded-md border border-slate-200 px-2.5 py-1 dark:border-slate-700"
            >{isEn ? 'Traceable sources' : '溯源可查'}</span
          >
          <span
            class="rounded-md border border-slate-200 px-2.5 py-1 dark:border-slate-700"
            >{isEn ? 'Bilingual' : '中英双语'}</span
          >
        </div>
      </div>

      <div>
        <h4
          class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-slate-900 dark:text-white"
        >
          {t('footer.links')}
        </h4>
        <ul class="space-y-3 text-sm">
          <li><a href={`${prefix}/policy/`}>{t('nav.policy')}</a></li>
          <li><a href={`${prefix}/facilities/`}>{t('nav.map')}</a></li>
          <li><a href={`${prefix}/compare/`}>{t('nav.compare')}</a></li>
          <li><a href={`${prefix}/docs/`}>{t('nav.docs')}</a></li>
          <li>
            <a href={`${prefix}/changelog/`}
              >{isEn ? 'Changelog' : '更新日志'}</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-slate-900 dark:text-white"
        >
          {t('footer.contact')}
        </h4>
        <p class="mb-5 text-sm leading-6 text-slate-600 dark:text-slate-400">
          {t('footer.contact_info')}
        </p>
        <a
          href={`${prefix}/legal/`}
          class="inline-flex items-center gap-2 text-xs font-semibold"
        >
          {isEn ? 'Legal & Privacy' : '法律与隐私声明'}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-slate-200 pt-6 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <span>&copy; {currentYear} CCUS Policy Hub.</span>
      <span
        >{
          isEn
            ? 'Open-source intelligence for global CCUS policies and projects.'
            : '全球 CCUS 政策与项目开源知识基础设施'
        }</span
      >
    </div>
  </div>
</footer>
