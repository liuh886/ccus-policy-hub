---
import { getCollection } from 'astro:content';
import PolicyDetail from '../../../components/PolicyDetail.astro';

export async function getStaticPaths() {
  const policies = await getCollection('policies_en');
  return policies.map((entry) => {
    const slug = entry.id.replace(/^en\//, '');
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
---

<PolicyDetail lang="en" entry={entry} />
