---
import type { CollectionEntry } from 'astro:content';
import { renderFacilityCardHtml } from '../lib/facilityCard.mjs';
import { toFacilityListItem } from '../lib/facilityListPayload.mjs';
import { SITE_BASE } from '../lib/siteBase';
import { t as translateUi, makePair, type UiKey } from '../i18n/ui';

interface Props {
  facility: CollectionEntry<'facilities_en'> | CollectionEntry<'facilities_zh'>;
}

const { facility } = Astro.props;
const isEn = facility.data.lang === 'en';
const lang = isEn ? 'en' : 'zh';
const t = (key: UiKey) => translateUi(lang, key);
const tp = makePair(lang);

const html = renderFacilityCardHtml(toFacilityListItem(facility), {
  base: SITE_BASE,
  lang,
  t,
  tp,
});
---

<Fragment set:html={html} />
