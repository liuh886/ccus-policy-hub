---
import {
  t as translateUi,
  defaultLang,
  resolveLang,
  type UiKey,
} from '../i18n/ui';
import { localePath } from '../lib/i18nRoutes';
import { SITE_BASE } from '../lib/siteBase';

interface Props {
  lang?: string;
}

const { lang = defaultLang } = Astro.props;
const resolvedLang = resolveLang(lang);
const t = (key: UiKey) => translateUi(resolvedLang, key);
const href = (path: string) => localePath(resolvedLang, path, SITE_BASE);

const BASE = SITE_BASE;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-footer-shell">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div class="max-w-md">
        <img
          src={`${BASE}/logo_optimized.svg`}
          alt="CCUS Policy Hub"
          width="220"
          height="48"
          class="mb-5 h-12 w-auto dark:hidden"
          loading="lazy"
        />
        <img
          src={`${BASE}/logo_dark.svg`}
          alt="CCUS Policy Hub"
          width="220"
          height="48"
          class="mb-5 h-12 w-auto hidden dark:block"
          loading="lazy"
        />
        <p class="text-sm leading-6 text-slate-500 dark:text-slate-400">
          {t('footer.description')}
        </p>
        <div
          class="mt-5 flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400"
        >
          <span
            class="rounded-md border border-slate-200 px-2.5 py-1 dark:border-slate-700"
            >{t('footer.badge.open_data')}</span
          >
          <span
            class="rounded-md border border-slate-200 px-2.5 py-1 dark:border-slate-700"
            >{t('footer.badge.traceable')}</span
          >
          <span
            class="rounded-md border border-slate-200 px-2.5 py-1 dark:border-slate-700"
            >{t('footer.badge.bilingual')}</span
          >
        </div>
      </div>

      <div>
        <h4
          class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-slate-900 dark:text-white"
        >
          {t('footer.links')}
        </h4>
        <ul class="space-y-3 text-sm">
          <li><a href={href('/policy/')}>{t('nav.policy')}</a></li>
          <li><a href={href('/facilities/')}>{t('nav.map')}</a></li>
          <li><a href={href('/compare/')}>{t('nav.compare')}</a></li>
          <li><a href={href('/docs/')}>{t('nav.docs')}</a></li>
          <li>
            <a href={href('/quality/')}>{t('footer.link.quality')}</a>
          </li>
          <li>
            <a href={href('/changelog/')}>{t('footer.link.changelog')}</a>
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-slate-900 dark:text-white"
        >
          {t('footer.contact')}
        </h4>
        <p class="mb-5 text-sm leading-6 text-slate-600 dark:text-slate-400">
          {t('footer.contact_info')}
        </p>
        <a
          href={href('/legal/')}
          class="inline-flex items-center gap-2 text-xs font-semibold"
        >
          {t('footer.legal')}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-slate-200 pt-6 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <span>&copy; {currentYear} CCUS Policy Hub.</span>
      <span>{t('footer.tagline')}</span>
    </div>
  </div>
</footer>
