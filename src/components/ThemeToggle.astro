---
const lang = Astro.currentLocale === 'en' ? 'en' : 'zh';
const labels =
  lang === 'en'
    ? {
        toDark: 'Switch to dark mode',
        toLight: 'Switch to light mode',
      }
    : {
        toDark: '切换深色模式',
        toLight: '切换浅色模式',
      };
---

<button
  type="button"
  class="site-icon-button transition-transform duration-150 active:scale-95 cursor-pointer"
  data-theme-toggle
  aria-label={labels.toDark}
  title={labels.toDark}
>
  <!-- Moon icon (shown in light mode, clicking switches to dark) -->
  <svg
    class="h-[19px] w-[19px] text-slate-600 transition-transform duration-200 hover:rotate-12 dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <!-- Sun icon (shown in dark mode, clicking switches to light) -->
  <svg
    class="h-[19px] w-[19px] text-amber-400 transition-transform duration-200 hover:rotate-45 hidden dark:block"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
</button>

<script>
  const updateToggleLabels = () => {
    const isDark = document.documentElement.classList.contains('dark');
    const isEn = document.documentElement.lang === 'en';
    const label = isDark
      ? isEn
        ? 'Switch to light mode'
        : '切换浅色模式'
      : isEn
        ? 'Switch to dark mode'
        : '切换深色模式';

    document
      .querySelectorAll<HTMLElement>('[data-theme-toggle]')
      .forEach((btn) => {
        btn.setAttribute('aria-label', label);
        btn.setAttribute('title', label);
      });
  };

  if (!(window as any).__ccusThemeToggleBound) {
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const toggle = target?.closest<HTMLElement>('[data-theme-toggle]');
      if (!toggle) return;

      const isDark = document.documentElement.classList.contains('dark');
      const nextTheme = isDark ? 'light' : 'dark';

      const manager = (window as any).__ccusThemeManager;
      if (manager?.setPreference) {
        manager.setPreference(nextTheme);
      } else {
        document.documentElement.classList.toggle('dark', nextTheme === 'dark');
        localStorage.setItem('theme', nextTheme);
        window.dispatchEvent(
          new CustomEvent('ccus:themechange', {
            detail: { preference: nextTheme, resolved: nextTheme },
          })
        );
      }
      updateToggleLabels();
    });

    document.addEventListener('astro:page-load', updateToggleLabels);
    window.addEventListener('ccus:themechange', updateToggleLabels);
    (window as any).__ccusThemeToggleBound = true;
  }

  updateToggleLabels();
</script>
