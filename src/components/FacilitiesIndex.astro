---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FacilityMap from './FacilityMap.astro';
import FacilityCard from './FacilityCard.astro';
import Pagination from './Pagination.astro';
import DatasetVersion from './DatasetVersion.astro';
import countryData from '../data/countries.json';
import {
  FACILITIES_PAGE_SIZE,
  sortFacilities,
} from '../lib/facilityPagination.mjs';
import { toFacilityListItem } from '../lib/facilityListPayload.mjs';
import { SITE_BASE } from '../lib/siteBase';

type FacilityEntry =
  | CollectionEntry<'facilities_en'>
  | CollectionEntry<'facilities_zh'>;

interface Props {
  lang?: 'zh' | 'en';
  /** Current page slice (Astro paginate). Falls back to the full collection. */
  items?: FacilityEntry[];
  pagination?: {
    current: number;
    total: number;
    prevUrl?: string;
    nextUrl?: string;
  };
}

const { lang = 'zh', items, pagination } = Astro.props;
const isEn = lang === 'en';

const facilities = await getCollection(
  isEn ? 'facilities_en' : 'facilities_zh'
);
// Paginated slice for the card grid. Filter dropdowns, the map and the
// client-side filter all use the full collection; only the server-rendered
// cards are sliced (progressive enhancement / SEO fallback).
const pageItems = items ?? facilities;
const countryMap: Record<string, any> = countryData;

const specialCountryLabels: Record<string, string> = {
  Unknown: '未知',
  'Multiple Europe': '欧洲多国',
  'Chinese Taipei': '中国台北',
  International: '国际',
  Transnational: '跨国',
};

const translateCountryLabel = (country: string) => {
  const direct = countryMap[country]?.zh || specialCountryLabels[country];
  if (direct) return direct;

  if (!/[,\-/&，、]/.test(country)) return country;

  return country
    .split(/(\s*[-/,&，、]\s*)/)
    .map((part) => {
      if (/^\s*[-/,&，、]\s*$/.test(part)) return part;
      const trimmed = part.trim();
      return (
        countryMap[trimmed]?.zh || specialCountryLabels[trimmed] || trimmed
      );
    })
    .join('');
};

const countries = Array.from(new Set(facilities.map((f) => f.data.country)))
  .sort()
  .map((canon) => ({
    canon,
    display: isEn ? canon : translateCountryLabel(canon),
  }));

const normalizeTypeLabel = (t: string) =>
  !isEn && (t === 'Full chain' || t === 'fullchain') ? '全产业链' : t;

const sectors = Array.from(new Set(facilities.map((f) => f.data.sector)))
  .filter(Boolean)
  .sort();
const types = Array.from(
  new Set(facilities.map((f) => normalizeTypeLabel(f.data.type)))
).sort();
const statuses = Array.from(
  new Set(facilities.map((f) => f.data.status))
).sort();

// Full compact dataset for client-side filter/sort/pagination. Canonical
// order must match the server page slices so the first client render is
// identical to the server-rendered fallback.
const listItems = sortFacilities(facilities).map((facility) => ({
  ...toFacilityListItem(facility),
  type: normalizeTypeLabel(facility.data.type),
}));
const listDataJson = JSON.stringify({ items: listItems });

const listPath = isEn ? '/en/facilities' : '/facilities';
const currentPage = pagination?.current ?? 1;
const pageSize = FACILITIES_PAGE_SIZE;

const copy = isEn
  ? {
      title: 'Facility Directory',
      description:
        'Global CCUS intelligence hub with multi-dimensional filtering by country, industry, status, and facility type.',
      searchPlaceholder: 'Search...',
      allCountries: 'Countries',
      allStatuses: 'Status',
      allSectors: 'Sectors',
      allTypes: 'Types',
      defaultSort: 'Default Sort',
      capacitySort: 'Capacity (High to Low)',
      yearSort: 'Year (Oldest to Newest)',
      noResults: 'No facilities found.',
      statMatching: 'Matching',
      statTotal: 'MTPA Total',
      statOperational: 'Operational',
      statOperationalCap: 'Operational MTPA',
      statConstructionCap: 'Under construction MTPA',
      active: 'Active',
      mtpa: 'MTPA',
    }
  : {
      title: '全球设施目录',
      description:
        '探索全球在运及计划中的 CCUS 设施，提供详细的产能数据、行业分类及地理空间位置。',
      keywords: 'CCUS 设施, 碳捕集项目地图, 全球封存点, 工业脱碳项目',
      searchPlaceholder: '项目搜索...',
      allCountries: '所有国家和地区',
      allStatuses: '所有状态',
      allSectors: '所有行业',
      allTypes: '所有类型',
      defaultSort: '默认排序',
      capacitySort: '按规模（大到小）',
      yearSort: '按年份（先到后）',
      noResults: '未找到符合条件的设施。',
      statMatching: '匹配项目',
      statTotal: '总规模 (MTPA)',
      statOperational: '当前在运',
      statOperationalCap: '在运产能',
      statConstructionCap: '在建产能',
      active: 'Active',
      mtpa: 'MTPA',
    };
---

<Layout
  title={copy.title}
  description={copy.description}
  keywords={copy.keywords}
>
  <div class="mb-12">
    <div class="max-w-3xl mb-10">
      <h1
        class="text-5xl font-black mb-4 tracking-tight text-slate-900 dark:text-white"
      >
        {copy.title}
      </h1>
      <p class="text-slate-500 text-lg leading-relaxed font-medium">
        {copy.description}
      </p>
    </div>

    <div class="relative mb-12 group/map-container">
      <FacilityMap lang={lang} />

      <div
        class="absolute bottom-6 left-6 z-[400] pointer-events-none flex flex-col gap-2"
      >
        <div
          class="bg-slate-900/90 dark:bg-slate-800/90 backdrop-blur-xl p-4 rounded-3xl border border-white/10 shadow-2xl transition-all duration-500 group-hover/map-container:translate-x-1"
        >
          <div class="flex items-center gap-6">
            <div class="flex flex-col">
              <span
                class="text-[9px] font-black text-blue-400 uppercase tracking-widest mb-0.5"
                >{copy.statMatching}</span
              >
              <div
                id="stat-count"
                class="text-xl font-black text-white leading-none"
              >
                0
              </div>
            </div>
            <div class="w-px h-8 bg-white/10"></div>
            <div class="flex flex-col">
              <span
                class="text-[9px] font-black text-blue-400 uppercase tracking-widest mb-0.5"
                >{copy.statTotal}</span
              >
              <div
                id="stat-capacity"
                class="text-xl font-black text-white leading-none"
              >
                0.0
              </div>
            </div>
            <div class="w-px h-8 bg-white/10"></div>
            <div class="flex flex-col">
              <span
                class="text-[9px] font-black text-emerald-400 uppercase tracking-widest mb-0.5"
                >{copy.statOperational}</span
              >
              <div class="flex items-baseline gap-1">
                <span
                  id="stat-operational"
                  class="text-xl font-black text-white leading-none">0</span
                >
                <span class="text-[9px] font-bold text-slate-500 uppercase"
                  >{copy.active}</span
                >
              </div>
            </div>
            <div class="w-px h-8 bg-white/10"></div>
            <div class="flex flex-col">
              <span
                class="text-[9px] font-black text-blue-400 uppercase tracking-widest mb-0.5"
                >{copy.statOperationalCap}</span
              >
              <div class="flex items-baseline gap-1">
                <span
                  id="stat-operational-cap"
                  class="text-xl font-black text-white leading-none">0.0</span
                >
                <span class="text-[9px] font-bold text-slate-500 uppercase"
                  >{copy.mtpa}</span
                >
              </div>
            </div>
            <div class="w-px h-8 bg-white/10"></div>
            <div class="flex flex-col">
              <span
                class="text-[9px] font-black text-amber-400 uppercase tracking-widest mb-0.5"
                >{copy.statConstructionCap}</span
              >
              <div class="flex items-baseline gap-1">
                <span
                  id="stat-construction-cap"
                  class="text-xl font-black text-white leading-none">0.0</span
                >
                <span class="text-[9px] font-bold text-slate-500 uppercase"
                  >{copy.mtpa}</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="sticky top-20 z-40 mb-12">
      <div
        class="grid grid-cols-1 md:grid-cols-6 gap-3 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl p-4 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xl"
      >
        <div class="md:col-span-1 relative">
          <input
            type="text"
            id="search-input"
            placeholder={copy.searchPlaceholder}
            class="w-full pl-9 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl text-xs outline-none focus:ring-2 focus:ring-blue-500 transition-all dark:text-white"
          />
          <svg
            class="absolute left-3 top-3 text-slate-400"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
            ></path></svg
          >
        </div>
        <select
          id="country-filter"
          class="px-3 py-2.5 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl text-xs outline-none focus:ring-2 focus:ring-blue-500 dark:text-white cursor-pointer font-bold"
        >
          <option value="">{copy.allCountries}</option>
          {countries.map((c) => <option value={c.canon}>{c.display}</option>)}
        </select>
        <select
          id="status-filter"
          class="px-3 py-2.5 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl text-xs outline-none focus:ring-2 focus:ring-blue-500 dark:text-white cursor-pointer font-bold text-emerald-600"
        >
          <option value="">{copy.allStatuses}</option>
          {statuses.map((s) => <option value={s}>{s}</option>)}
        </select>
        <select
          id="sector-filter"
          class="px-3 py-2.5 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl text-xs outline-none focus:ring-2 focus:ring-blue-500 dark:text-white cursor-pointer font-bold"
        >
          <option value="">{copy.allSectors}</option>
          {sectors.map((s) => <option value={s}>{s}</option>)}
        </select>
        <select
          id="type-filter"
          class="px-3 py-2.5 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl text-xs outline-none focus:ring-2 focus:ring-blue-500 dark:text-white cursor-pointer font-bold"
        >
          <option value="">{copy.allTypes}</option>
          {types.map((t) => <option value={t}>{t}</option>)}
        </select>
        <select
          id="sort-select"
          class="px-3 py-2.5 bg-blue-50 dark:bg-blue-900/30 border-none rounded-2xl text-xs outline-none focus:ring-2 focus:ring-blue-500 dark:text-white cursor-pointer font-bold text-blue-600"
        >
          <option value="default">{copy.defaultSort}</option>
          <option value="capacity-desc">{copy.capacitySort}</option>
          <option value="year-asc">{copy.yearSort}</option>
        </select>
      </div>
    </div>

    <div
      id="facility-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      data-page-size={pageSize}
      data-current-page={currentPage}
      data-list-path={listPath}
      data-site-base={SITE_BASE}
      data-lang={lang}
    >
      {
        pageItems.map((f) => (
          <div class="facility-item">
            <FacilityCard facility={f} />
          </div>
        ))
      }
    </div>

    <div
      id="no-results"
      class="hidden py-32 text-center bg-slate-50 dark:bg-slate-900/50 rounded-[3rem] border-2 border-dashed border-slate-200 dark:border-slate-800"
    >
      <p class="text-slate-500 font-bold">{copy.noResults}</p>
    </div>

    <div id="facility-pagination">
      {
        pagination && pagination.total > 1 && (
          <Pagination
            current={pagination.current}
            total={pagination.total}
            prevUrl={pagination.prevUrl}
            nextUrl={pagination.nextUrl}
            lang={lang}
          />
        )
      }
    </div>

    <!-- Dataset Version Metadata -->
    <DatasetVersion lang={lang} compact />
  </div>
</Layout>

<script
  is:inline
  type="application/json"
  id="facility-list-data"
  set:html={listDataJson}
/>

<script>
  import { renderFacilityCardHtml } from '../lib/facilityCard.mjs';
  import {
    computeFacilityStats,
    filterFacilities,
    paginateFacilities,
    sortFacilityItems,
  } from '../lib/facilityListQuery.mjs';
  import { t as translateUi, makePair, type UiKey } from '../i18n/ui';

  interface FacilityListItem {
    id: string | number | null;
    name: string | null;
    country: string | null;
    region: string | null;
    sector: string | null;
    type: string | null;
    status: string | null;
    estimatedCapacity: number | null;
    announcedCapacityMax: number | null;
    announcement: string | null;
    hub: string | null;
    partners: string;
    operator: string | null;
    phase: string | null;
    precision: string | null;
  }

  let abortCurrent: AbortController | null = null;

  function readListPayload(): FacilityListItem[] {
    const el = document.getElementById(
      'facility-list-data'
    ) as HTMLScriptElement | null;
    const raw = el?.textContent?.trim() || '';
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw) as { items?: unknown };
      return Array.isArray(parsed.items)
        ? (parsed.items as FacilityListItem[])
        : [];
    } catch (error) {
      console.warn('Facility list payload is not valid JSON.', error);
      return [];
    }
  }

  function setupFacilityFiltering() {
    const grid = document.getElementById('facility-grid') as HTMLElement | null;
    if (!grid) return;

    abortCurrent?.abort();
    const controller = new AbortController();
    abortCurrent = controller;
    const { signal } = controller;

    const searchInput = document.getElementById(
      'search-input'
    ) as HTMLInputElement | null;
    const countryFilter = document.getElementById(
      'country-filter'
    ) as HTMLSelectElement | null;
    const statusFilter = document.getElementById(
      'status-filter'
    ) as HTMLSelectElement | null;
    const sectorFilter = document.getElementById(
      'sector-filter'
    ) as HTMLSelectElement | null;
    const typeFilter = document.getElementById(
      'type-filter'
    ) as HTMLSelectElement | null;
    const sortSelect = document.getElementById(
      'sort-select'
    ) as HTMLSelectElement | null;
    const noResults = document.getElementById('no-results');
    const paginationHost = document.getElementById('facility-pagination');

    const statCount = document.getElementById('stat-count');
    const statCapacity = document.getElementById('stat-capacity');
    const statOperational = document.getElementById('stat-operational');
    const statOperationalCap = document.getElementById('stat-operational-cap');
    const statConstructionCap = document.getElementById(
      'stat-construction-cap'
    );

    const allItems = readListPayload();
    const pageSize = Number(grid.dataset.pageSize) || 48;
    const siteBase = grid.dataset.siteBase || '';
    const listPath = grid.dataset.listPath || '/facilities';
    const lang = grid.dataset.lang === 'en' ? 'en' : 'zh';
    const t = (key: UiKey) => translateUi(lang, key);
    const tp = makePair(lang);
    const cardCtx = { base: siteBase, lang, t, tp };

    const params = new URLSearchParams(window.location.search);
    const state = {
      q: params.get('q') || '',
      country: params.get('country') || '',
      status: params.get('status') || '',
      sector: params.get('sector') || '',
      type: params.get('type') || '',
      sort: params.get('sort') || 'default',
      page: Number(grid.dataset.currentPage) || 1,
    };

    const applyStateToControls = () => {
      if (searchInput) searchInput.value = state.q;
      if (countryFilter) countryFilter.value = state.country;
      if (statusFilter) statusFilter.value = state.status;
      if (sectorFilter) sectorFilter.value = state.sector;
      if (typeFilter) typeFilter.value = state.type;
      if (sortSelect) sortSelect.value = state.sort;
    };

    const syncUrl = (page: number) => {
      const search = new URLSearchParams();
      if (state.q) search.set('q', state.q);
      if (state.country) search.set('country', state.country);
      if (state.status) search.set('status', state.status);
      if (state.sector) search.set('sector', state.sector);
      if (state.type) search.set('type', state.type);
      if (state.sort !== 'default') search.set('sort', state.sort);
      const query = search.toString();
      const path =
        page <= 1
          ? `${siteBase}${listPath}/`
          : `${siteBase}${listPath}/page/${page}`;
      const url = `${path}${query ? `?${query}` : ''}`;
      window.history.replaceState(window.history.state, '', url);
    };

    const renderPagination = (page: number, total: number) => {
      if (!paginationHost) return;
      if (total <= 1) {
        paginationHost.innerHTML = '';
        return;
      }

      const buttonClass =
        'px-4 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg hover:border-blue-500 transition-colors text-sm font-medium cursor-pointer';
      const disabledClass =
        'px-4 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-900 rounded-lg text-slate-300 text-sm cursor-not-allowed';

      const prev = `<button type="button" data-page="${page - 1}" class="${page > 1 ? buttonClass : disabledClass}" ${page > 1 ? '' : 'disabled'}>&larr; ${tp('上一页', 'Previous')}</button>`;
      const next = `<button type="button" data-page="${page + 1}" class="${page < total ? buttonClass : disabledClass}" ${page < total ? '' : 'disabled'}>${tp('下一页', 'Next')} &rarr;</button>`;
      const label = `<span class="text-sm font-bold text-slate-500">${tp(`第 ${page} 页 / 共 ${total} 页`, `Page ${page} of ${total}`)}</span>`;

      paginationHost.innerHTML = `<nav class="flex justify-center items-center gap-4 mt-12">${prev}${label}${next}</nav>`;

      paginationHost
        .querySelectorAll<HTMLButtonElement>('button[data-page]')
        .forEach((button) => {
          button.addEventListener(
            'click',
            () => {
              const target = Number(button.dataset.page);
              if (!Number.isFinite(target) || target < 1 || target > total) {
                return;
              }
              state.page = target;
              render();
              grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
            },
            { signal }
          );
        });
    };

    const render = () => {
      const filtered = filterFacilities(allItems, state);
      const sorted = sortFacilityItems(filtered, state.sort);
      const paged = paginateFacilities(sorted, state.page, pageSize);
      state.page = paged.page;

      grid.innerHTML = paged.items
        .map(
          (item: FacilityListItem) =>
            `<div class="facility-item">${renderFacilityCardHtml(item, cardCtx)}</div>`
        )
        .join('');

      const stats = computeFacilityStats(filtered);
      if (statCount) statCount.textContent = stats.count.toString();
      if (statCapacity) statCapacity.textContent = stats.capacity.toFixed(1);
      if (statOperational)
        statOperational.textContent = stats.operational.toString();
      if (statOperationalCap)
        statOperationalCap.textContent = stats.operationalCap.toFixed(1);
      if (statConstructionCap)
        statConstructionCap.textContent = stats.constructionCap.toFixed(1);

      if (noResults)
        noResults.style.display = stats.count === 0 ? 'block' : 'none';

      renderPagination(paged.page, paged.total);
      syncUrl(paged.page);
    };

    const onFilterChange = () => {
      state.q = searchInput?.value ?? '';
      state.country = countryFilter?.value ?? '';
      state.status = statusFilter?.value ?? '';
      state.sector = sectorFilter?.value ?? '';
      state.type = typeFilter?.value ?? '';
      state.sort = sortSelect?.value || 'default';
      state.page = 1;
      render();
    };

    applyStateToControls();

    [
      searchInput,
      countryFilter,
      statusFilter,
      sectorFilter,
      typeFilter,
      sortSelect,
    ]
      .filter((el): el is HTMLInputElement | HTMLSelectElement => Boolean(el))
      .forEach((el) => {
        el.addEventListener('input', onFilterChange, { signal });
        el.addEventListener('change', onFilterChange, { signal });
      });

    render();
  }

  document.addEventListener('astro:before-swap', () => {
    abortCurrent?.abort();
    abortCurrent = null;
  });
  document.addEventListener('astro:page-load', setupFacilityFiltering);
  setupFacilityFiltering();
</script>
