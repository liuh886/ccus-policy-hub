---
import '../styles/light-editorial-home.css';
import '../styles/interaction-controls.css';
import {
  CAPACITY_TREND_END_YEAR,
  CAPACITY_TREND_START_YEAR,
  UNDER_CONSTRUCTION_OPERATION_YEAR_CUTOFF,
  facilityCapacity,
  normalizeFacilityStatus,
  normalizeFacilityType,
  projectRecordYear,
  summarizeFacilities,
} from '../lib/capacityMetrics.mjs';
import { getLocaleDataIndex, type Locale } from '../lib/dataIndex';
import { SITE_BASE } from '../lib/siteBase';
import { t as translateUi } from '../i18n/ui';

interface Props {
  showSummary?: boolean;
  lang?: Locale;
}

const showSummary = Astro.props.showSummary ?? true;
const lang: Locale =
  (Astro.props.lang ?? Astro.currentLocale) === 'en' ? 'en' : 'zh';
const { facilities } = await getLocaleDataIndex(lang);

const startYear = CAPACITY_TREND_START_YEAR;
const endYear = CAPACITY_TREND_END_YEAR;
const defaultMinYear = 1990;
const defaultMaxYear = 2030;
const pipelineStatuses = new Set([
  'planned',
  'operational',
  'under-construction',
]);
const committedStatuses = new Set(['operational', 'under-construction']);
const typeOptions = [
  { id: 'capture', label: 'Capture' },
  { id: 'transport', label: 'Transport' },
  { id: 'ts', label: 'T&S' },
  { id: 'storage', label: 'Storage' },
  { id: 'full-chain', label: 'Full chain' },
  { id: 'ccu', label: 'CCU' },
] as const;

type TypeId = (typeof typeOptions)[number]['id'];
const typeLabels: Record<TypeId, { zh: string; en: string }> = {
  capture: { zh: '碳捕集 (Capture)', en: 'Capture' },
  transport: { zh: '碳运输 (Transport)', en: 'Transport' },
  ts: { zh: '运输与封存 (T&S)', en: 'T&S' },
  storage: { zh: '地质封存 (Storage)', en: 'Storage' },
  'full-chain': { zh: '全产业链 (Full chain)', en: 'Full chain' },
  ccu: { zh: '碳利用 (CCU)', en: 'CCU' },
};
type ChartPoint = {
  year: number;
  operational: number;
  pipeline: number;
};
type CapacityRecord = {
  year: number;
  typeId: TypeId | null;
  capacity: number;
  committed: boolean;
  pipeline: boolean;
};

const text = {
  totalTitle:
    lang === 'zh' ? '全球项目记录能力' : 'Global Project-Record Capacity',
  totalYearSuffix: lang === 'zh' ? '估' : ' Est.',
  totalNote:
    lang === 'zh'
      ? 'Planned、Operational 与 Under construction 项目记录能力累计；排除 Cancelled / Decommissioned / Suspended。'
      : 'Cumulative project-record capacity for Planned, Operational and Under construction records; Cancelled / Decommissioned / Suspended excluded.',
  chartTitle:
    lang === 'zh'
      ? '全球 CCUS 项目记录能力增长趋势'
      : 'CCUS Project-Record Capacity Growth',
  committedLabel:
    lang === 'zh'
      ? '确定性能力（在运+在建）'
      : 'Committed (Operational + Under construction)',
  pipelineLabel:
    lang === 'zh'
      ? '公开管线（规划+在运+在建）'
      : 'Pipeline (Planned + Operational + Under construction)',
  typeFilterTitle: lang === 'zh' ? '类型' : 'Types',
  operationalTitle:
    lang === 'zh'
      ? '在运设施（项目记录规模）'
      : 'Operational facilities (project-record scale)',
  constructionTitle:
    lang === 'zh'
      ? `在建设施（预计 ${UNDER_CONSTRUCTION_OPERATION_YEAR_CUTOFF} 年及以前投运）`
      : `Under-construction facilities (operating ≤${UNDER_CONSTRUCTION_OPERATION_YEAR_CUTOFF})`,
  storageSubsetLabel: lang === 'zh' ? '其中封存相关' : 'Storage-related subset',
  storageSubsetNote:
    lang === 'zh'
      ? `封存相关包括 T&S、Storage 与 Full chain 项目记录；不等于净可交付地质封存能力。在建卡仅统计预计 ${UNDER_CONSTRUCTION_OPERATION_YEAR_CUTOFF} 年及以前投运记录，全量在建项目见下方项目格局面板。`
      : `Storage-related includes T&S, Storage and Full chain project records; it is not net deliverable geological storage capacity. The under-construction card counts records operating ≤${UNDER_CONSTRUCTION_OPERATION_YEAR_CUTOFF}; see Project Landscape below for all active under-construction records.`,
  chartNote:
    lang === 'zh'
      ? '注：本图采用 project-record 口径，按 operation → FID → announcement 年份累计 Planned、Operational、Under construction 项目记录能力；Cancelled、Decommissioned、Suspended 被排除。筛选项覆盖 capture、transport、T&S、storage、full-chain、CCU。数值为跨类型项目记录能力加总，不代表净可交付捕集能力或净封存能力。'
      : 'Note: This chart uses a project-record methodology, accumulating Planned, Operational and Under construction records by operation → FID → announcement year; Cancelled, Decommissioned and Suspended records are excluded. The type filter covers capture, transport, T&S, storage, full-chain and CCU. Values aggregate project-record capacity across selected types and should not be interpreted as net deliverable capture or storage capacity.',
  // Error strings are shared keys in src/i18n/ui.ts (single source);
  // the client catch-block already falls back to the same keys.
  chartErrorTitle: translateUi(lang, 'capacity.error.title'),
  chartErrorNote: translateUi(lang, 'capacity.error.note'),
  chartErrorAction: translateUi(lang, 'capacity.error.action'),
};

const trendYears = Array.from(
  { length: endYear - startYear + 1 },
  (_, index) => startYear + index
);

const capacityRecords: CapacityRecord[] = facilities.flatMap((facility) => {
  const year = projectRecordYear(facility);
  const status = normalizeFacilityStatus(facility.data.status);

  if (
    !year ||
    year < startYear ||
    year > endYear ||
    !pipelineStatuses.has(status)
  ) {
    return [];
  }

  return [
    {
      year,
      typeId: normalizeFacilityType(facility.data.type) as TypeId | null,
      capacity: facilityCapacity(facility.data),
      committed: committedStatuses.has(status),
      pipeline: true,
    },
  ];
});

const buildSeries = (records: CapacityRecord[]): ChartPoint[] => {
  let cumulativeCommitted = 0;
  let cumulativePipeline = 0;

  return trendYears.map((year) => {
    records.forEach((record) => {
      if (record.year !== year) return;
      if (record.committed) cumulativeCommitted += record.capacity;
      if (record.pipeline) cumulativePipeline += record.capacity;
    });

    return {
      year,
      operational: cumulativeCommitted,
      pipeline: cumulativePipeline,
    };
  });
};

const chartData = buildSeries(capacityRecords);
const typeChartData: Record<string, ChartPoint[]> = {};
typeOptions.forEach((option) => {
  typeChartData[option.id] = buildSeries(
    capacityRecords.filter((record) => record.typeId === option.id)
  );
});

const capacityAtYear = (series: ChartPoint[], year: number): number =>
  series.find((point) => point.year === year)?.pipeline || 0;

const totalCapacity = capacityAtYear(chartData, defaultMaxYear).toFixed(1);
const operationalSummary = summarizeFacilities(facilities, 'operational');
const constructionSummary = summarizeFacilities(
  facilities,
  'under-construction'
);

const formatCapacity = (value: number): string => value.toFixed(1);
const metricOpen = lang === 'zh' ? '（' : '(';
const metricClose = lang === 'zh' ? '）' : ')';
---

<div
  data-capacity-trend
  data-show-summary={showSummary ? 'true' : 'false'}
  class={showSummary
    ? 'mb-16 grid grid-cols-1 gap-8 lg:grid-cols-3'
    : 'mb-16 grid grid-cols-1'}
>
  {
    showSummary && (
      <div class="space-y-6 lg:col-span-1">
        <section class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-500 hover:border-emerald-500/50 dark:border-slate-800 dark:bg-slate-900">
          <div class="absolute left-0 top-0 h-full w-1.5 bg-emerald-500/0 transition-all group-hover:bg-emerald-500/50" />
          <div class="absolute right-4 top-2 font-mono text-[8px] text-slate-300 dark:text-slate-700">
            CAP_MONITOR_v3.5
          </div>
          <h3 class="mb-4 text-xs font-black uppercase tracking-widest text-slate-400">
            {text.totalTitle}
            <span data-capacity-total-year>
              ({defaultMaxYear}
              {text.totalYearSuffix})
            </span>
          </h3>
          <div class="mb-2 text-5xl font-black tracking-tighter text-emerald-600">
            <span data-capacity-total>{totalCapacity}</span>
            <span class="text-sm font-bold uppercase text-slate-400">Mtpa</span>
          </div>
          <p class="text-xs font-medium text-slate-500">{text.totalNote}</p>
        </section>

        <section
          class="relative overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 p-8 text-white shadow-2xl"
          aria-describedby="storage-related-method-note"
        >
          <div class="space-y-5">
            <div>
              <h3 class="mb-2 text-[11px] font-black uppercase tracking-widest text-blue-300">
                {text.operationalTitle}
              </h3>
              <p class="text-3xl font-black tracking-tight text-white">
                {operationalSummary.totalCount}
                {lang === 'zh' ? '个' : ''}
                <span class="text-lg font-bold text-blue-300">
                  {metricOpen}
                  {formatCapacity(operationalSummary.totalCapacity)} Mtpa
                  {metricClose}
                </span>
              </p>
              <p class="mt-2 text-sm font-semibold text-emerald-300">
                {text.storageSubsetLabel}
                {operationalSummary.storageRelatedCount}
                {lang === 'zh' ? '个' : ''}
                {metricOpen}
                {formatCapacity(operationalSummary.storageRelatedCapacity)} Mtpa
                {metricClose}
              </p>
            </div>

            <div class="border-t border-white/10 pt-5">
              <h3 class="mb-2 text-[11px] font-black uppercase tracking-widest text-emerald-300">
                {text.constructionTitle}
              </h3>
              <p class="text-3xl font-black tracking-tight text-white">
                {constructionSummary.totalCount}
                {lang === 'zh' ? '个' : ''}
                <span class="text-lg font-bold text-emerald-300">
                  {metricOpen}
                  {formatCapacity(constructionSummary.totalCapacity)} Mtpa
                  {metricClose}
                </span>
              </p>
              <p class="mt-2 text-sm font-semibold text-emerald-300">
                {text.storageSubsetLabel}
                {constructionSummary.storageRelatedCount}
                {lang === 'zh' ? '个' : ''}
                {metricOpen}
                {formatCapacity(
                  constructionSummary.storageRelatedCapacity
                )}{' '}
                Mtpa{metricClose}
              </p>
            </div>
          </div>

          <p
            id="storage-related-method-note"
            class="mt-5 border-t border-white/10 pt-4 text-[10px] leading-relaxed text-slate-400"
          >
            {text.storageSubsetNote}
          </p>
        </section>
      </div>
    )
  }

  <section
    class={`group/chart relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-500 hover:border-blue-500/30 dark:border-slate-800 dark:bg-slate-900 ${showSummary ? 'lg:col-span-2' : ''}`}
  >
    <div class="relative z-10 mb-4 flex items-start justify-between gap-4">
      <div>
        <h3
          class="mb-1 text-lg font-black uppercase tracking-tight dark:text-white"
        >
          {text.chartTitle}
        </h3>
        <p
          class="text-[10px] font-bold uppercase tracking-widest text-slate-400"
        >
          Project-record capacity across selected CCUS types (Mtpa)
          <span class="text-blue-500">1970</span> -
          <span class="text-emerald-500" data-capacity-subtitle-max
            >{defaultMaxYear}</span
          >
        </p>
      </div>
      <div
        class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-blue-700 shadow-sm dark:border-blue-500/20 dark:bg-blue-500/10 dark:text-blue-400"
      >
        IEA 2026 Intelligence
      </div>
    </div>

    <div class="relative z-10 mb-6 mt-2 flex flex-col gap-3 px-2">
      <div class="flex items-center justify-between gap-4">
        <div
          id="timeRangeIndicator"
          class="rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1 font-mono text-[10px] text-blue-600 dark:text-blue-400"
        >
          <span class="opacity-40">[</span>
          <span id="yearMinVal" class="font-bold">{defaultMinYear}</span> -
          <span id="yearMaxVal" class="font-bold">{defaultMaxYear}</span>
          <span class="opacity-40">]</span>
          <span
            class="ml-1.5 text-[9px] font-black tracking-tighter text-emerald-500"
          >
            {lang === 'zh' ? '视图激活' : 'ACTIVE_VIEW'}
          </span>
        </div>
        <div
          class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400"
        >
          Timeline viewport
        </div>
      </div>

      <div class="group/slider relative flex h-7 w-full items-center">
        <div
          class="absolute h-1 w-full rounded-full bg-slate-100 shadow-inner dark:bg-slate-800/50"
        >
        </div>
        <div id="sliderTrackHighlight" class="absolute z-10 rounded-full"></div>
        <input
          type="range"
          id="minYearSlider"
          min={startYear}
          max={endYear}
          value={defaultMinYear}
          aria-label={lang === 'en'
            ? 'Minimum year in active range'
            : '有效时间范围起始年份'}
        />
        <input
          type="range"
          id="maxYearSlider"
          min={startYear}
          max={endYear}
          value={defaultMaxYear}
          aria-label={lang === 'en'
            ? 'Maximum year in active range'
            : '有效时间范围结束年份'}
        />
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-[100px_1fr]">
      <aside
        id="capacityTypeFilter"
        class="rounded-xl border border-slate-200 bg-slate-50/70 px-3 py-3 dark:border-slate-800 dark:bg-slate-950/30"
      >
        <div
          class="mb-2 text-[9px] font-black uppercase tracking-widest text-slate-500 dark:text-slate-400"
        >
          {text.typeFilterTitle}
        </div>
        <div class="space-y-1.5">
          {
            typeOptions.map((option) => (
              <label
                for={`capacity-type-${option.id}`}
                class="flex cursor-pointer select-none items-center gap-1.5 text-[10px] font-bold text-slate-600 dark:text-slate-300"
              >
                <input
                  id={`capacity-type-${option.id}`}
                  type="checkbox"
                  value={option.id}
                  checked
                  data-capacity-type
                  class="h-3 w-3 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
                />
                <span>
                  {lang === 'zh' ? typeLabels[option.id].zh : option.label}
                </span>
              </label>
            ))
          }
        </div>
      </aside>

      <div id="capacityChartShell" class="relative h-[300px] w-full">
        <canvas
          id="capacityChart"
          data-values={JSON.stringify(chartData)}
          data-type-series={JSON.stringify(typeChartData)}
          data-label-op={text.committedLabel}
          data-label-pipe={text.pipelineLabel}
          data-error-title={text.chartErrorTitle}
          data-error-note={text.chartErrorNote}
          data-error-action={text.chartErrorAction}
          data-base={SITE_BASE}
          data-default-min-year={defaultMinYear}
          data-default-max-year={defaultMaxYear}
          data-start-year={startYear}
          data-end-year={endYear}
          data-year-suffix={text.totalYearSuffix}></canvas>
      </div>
    </div>

    <p
      class="relative z-10 mt-4 text-[10px] leading-relaxed text-slate-500 dark:text-slate-400"
    >
      {text.chartNote}
    </p>
  </section>
</div>

<script>
  import { mountCapacityTrend } from '../scripts/capacityTrend';
  mountCapacityTrend();
</script>
